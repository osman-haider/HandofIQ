# Required — chat model used for the conversational agent + confidence scoring
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# Optional — only needed for the "nice to have" voice input/output features.
# If omitted, they default to the values below.
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# Optional — where the demo's SQLite file is written
HANDOFF_IQ_DB_PATH=./handoff_iq.db
